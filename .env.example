# Copy this file to ".env" and change the passwords:
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
# The real .env is listed in .gitignore and must never be pushed.

# --- PostgreSQL ---
POSTGRES_USER=divvy_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=divvy
POSTGRES_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=8080
